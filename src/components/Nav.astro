---
const links = [
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/resume', label: 'Resume' },
  { href: '/services', label: 'Services', cta: true },
];
const { pathname } = Astro.url;
---

<nav class="border-b border-line">
  <div class="mx-auto flex h-16 w-full max-w-[1120px] flex-wrap items-center justify-between gap-x-6 px-8">
    <a href="/" class="font-mono text-[13px] tracking-[0.08em] text-hi no-underline">
      <span class="font-medium text-accent">▸</span> richardlandy.me
    </a>
    <div class="flex items-center gap-7">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'font-display text-sm font-medium no-underline transition-colors',
              l.cta ? 'text-accent' : 'text-mid hover:text-hi',
              pathname.startsWith(l.href) && 'text-hi',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>
