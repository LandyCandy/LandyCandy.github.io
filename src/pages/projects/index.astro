---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const copy = (await getEntry('copy', 'projects'))!.data;

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base title="Projects" description="Machine vision and optical inspection projects — challenge and approach, confidentiality-safe.">
  <section class="mx-auto w-full max-w-[1120px] px-8 py-18">
    <div class="ro mb-3">// selected work · confidential-safe</div>
    <h1 class="mb-4 font-display text-[40px] leading-tight font-bold tracking-[-0.01em]">Projects</h1>
    <p class="mb-12 max-w-[620px] text-mid">{copy.intro}</p>
    {
      projects.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2">
          {projects.map((p, i) => (
            <ProjectCard project={p} index={i} />
          ))}
        </div>
      ) : (
        <p class="ro">no public writeups yet</p>
      )
    }
  </section>
</Base>
