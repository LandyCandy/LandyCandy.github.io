---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';

const copy = (await getEntry('copy', 'contact'))!.data;

// Formspree: plain HTML POST to their endpoint, no backend, no JS.
// The destination email is configured in the Formspree dashboard and never
// appears in markup. Empty ID = form hidden (see site.config.ts).
const formAction = SITE.formspreeId ? `https://formspree.io/f/${SITE.formspreeId}` : '';
---

<Base title="Contact" description={`Contact ${SITE.name} about machine vision and optical inspection work.`}>
  <section class="mx-auto w-full max-w-[640px] px-8 py-18">
    <div class="ro mb-3">// contact</div>
    <h1 class="mb-4 font-display text-[40px] leading-tight font-bold tracking-[-0.01em]">
      Get in touch
    </h1>
    <p class="mb-10 text-mid">
      {copy.intro}
      {SITE.linkedin ? (
        <>find me on <a href={SITE.linkedin} rel="me noopener" class="text-accent">LinkedIn</a>.</>
      ) : (
        <>LinkedIn works too (link in the footer soon).</>
      )}
    </p>

    {formAction ? (
      <form
        name="contact"
        method="POST"
        action={formAction}
        class="grid gap-5"
      >
        <input type="hidden" name="_subject" value="Contact form — richardlandy.me" />
        <p class="hidden" aria-hidden="true">
          <label>Don't fill this out: <input name="_gotcha" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div>
          <label for="name" class="ro mb-2 block">name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full rounded-sm border border-line bg-surface px-4 py-3 text-hi outline-none focus:border-accent"
          />
        </div>
        <div>
          <label for="email" class="ro mb-2 block">email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-sm border border-line bg-surface px-4 py-3 text-hi outline-none focus:border-accent"
          />
        </div>
        <div>
          <label for="message" class="ro mb-2 block">message</label>
          <textarea
            id="message"
            name="message"
            rows="6"
            required
            class="w-full rounded-sm border border-line bg-surface px-4 py-3 text-hi outline-none focus:border-accent"
          ></textarea>
        </div>
        <div>
          <button type="submit" class="btn btn-primary">Send</button>
        </div>
      </form>
    ) : (
      <p class="rounded-sm border border-line bg-surface px-4 py-3 text-mid">
        The contact form is being set up — LinkedIn is the best way to reach me for now.
      </p>
    )}
  </section>
</Base>
