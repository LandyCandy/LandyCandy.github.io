---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config';

export async function getStaticPaths() {
  if (!SITE.pages.blog) return []; // page flag — see site.config.ts
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, summary, tags } = post.data;
const { Content } = await render(post);
---

<Base title={title} description={summary}>
  <article class="mx-auto w-full max-w-[820px] px-8 py-18">
    <div class="ro mb-3">// {date.toISOString().slice(0, 10)}</div>
    <h1 class="mb-6 font-display text-[40px] leading-tight font-bold tracking-[-0.01em]">
      {title}
    </h1>
    {
      tags.length > 0 && (
        <div class="mb-10 flex flex-wrap gap-2.5">
          {tags.map((t) => (
            <span class="chip">{t}</span>
          ))}
        </div>
      )
    }
    <div class="prose">
      <Content />
    </div>
    <div class="mt-14 border-t border-line pt-8">
      <a class="link-mono" href="/blog">← all posts</a>
    </div>
  </article>
</Base>
