---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE } from '../site.config';

// Page flag — see site.config.ts. A 404 response means no file is built.
if (!SITE.pages.services) return new Response(null, { status: 404 });

// Offerings: src/content/services/*.md (body = description).
// Page copy:  src/content/copy/services.md
const copy = (await getEntry('copy', 'services'))!.data;

const offerings = await Promise.all(
  (await getCollection('services'))
    .sort((a, b) => a.data.order - b.data.order)
    .map(async (s) => ({ ...s.data, Content: (await render(s)).Content }))
);
---

<Base
  title="Services"
  description="Independent machine vision consulting — inspection feasibility, vision system architecture, and advisory for advanced manufacturing."
>
  <section class="mx-auto w-full max-w-[820px] px-8 py-18">
    <div class="ro mb-3">// independent engagements</div>
    <h1 class="mb-4 font-display text-[40px] leading-tight font-bold tracking-[-0.01em]">
      Work with me
    </h1>
    <p class="mb-12 max-w-[620px] text-mid">{copy.intro}</p>

    <div class="grid gap-6">
      {
        offerings.map((s) => (
          <div class="rounded border border-line bg-surface p-6 transition-colors hover:border-accent">
            <h2 class="mb-2 font-display text-xl font-semibold text-hi">{s.title}</h2>
            <div class="prose text-sm">
              <s.Content />
            </div>
          </div>
        ))
      }
    </div>

    <div class="mt-12 text-center">
      <a class="btn btn-primary" href="/contact">Start a conversation</a>
    </div>

    {copy.disclaimer && <p class="ro mt-14 text-center">{copy.disclaimer}</p>}
  </section>
</Base>
