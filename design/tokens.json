{
  "$description": "Design tokens for richardlandy.me 'Inspection' theme. Accent: Laser Violet.",
  "color": {
    "neutral": {
      "bg-0": "#1A1D21",
      "bg-1": "#22262B",
      "bg-2": "#2C3137",
      "line": "#3A4046",
      "line-soft": "#2E3339",
      "text-hi": "#E8EBEE",
      "text-mid": "#A3ACB5",
      "text-low": "#6E7883"
    },
    "semantic": {
      "pass": "#6BC495",
      "fail": "#D9636F"
    },
    "accent": {
      "accent": "#A48ED9",
      "accent-ink": "#1C1330",
      "accent-glow": "rgba(164,142,217,0.16)"
    }
  },
  "font": {
    "display": "'Space Grotesk', Inter, system-ui, sans-serif",
    "body": "Inter, system-ui, sans-serif",
    "mono": "'JetBrains Mono', 'Cascadia Code', Consolas, monospace"
  },
  "typeScale": {
    "display-xl": { "size": 64, "line": 1.05, "tracking": "-0.02em", "weight": 700, "font": "display" },
    "display-l": { "size": 40, "line": 1.1, "tracking": "-0.01em", "weight": 700, "font": "display" },
    "heading": { "size": 28, "line": 1.2, "tracking": "0", "weight": 600, "font": "display" },
    "body": { "size": 16, "line": 1.65, "tracking": "0", "weight": 400, "font": "body" },
    "small": { "size": 14, "line": 1.5, "tracking": "0", "weight": 400, "font": "body" },
    "readout": { "size": 11, "line": 1.4, "tracking": "0.14em", "weight": 500, "font": "mono", "transform": "uppercase" }
  },
  "radius": { "interactive": 2, "card": 4 },
  "spacing": { "base": 4, "steps": [8, 12, 16, 24, 32, 48, 64, 96], "maxWidth": 1120, "sectionGap": 96 }
}
